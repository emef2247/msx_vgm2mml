@e01 = { 1, 0, F, 0=15 }
@e09 = { 1, 0, F, E, B=6 }
@e10 = { 1, 0, F, E, 9=10 }31475a6a757d7f7d756a5a47311900e7cfb9a6968b8380838b96a6b9cfe7 }


; 目的: 連続半音 (クロマチック) による F-Num / Block 計算 & KeyOn/Off の基本検証
; 範囲: o3 c から o4 c まで 12 半音 + 最後に戻り
; 使用パッチ: @1 (ROM 音色 1 想定)

1 @1 v14 o3 l8 c c+ d d+ e f f+ g g+ a a+ b > c
1 @1 v14 o3 l8 r r r r r r r r r r r r r