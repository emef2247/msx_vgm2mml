;[name=retrigger lpf=1]
#opll_mode 1
#tempo 75
#title { "Rapid Retrigger" }
#alloc 1=400
#alloc 2=200
#alloc 3=400
#psg_tune { 3392, 3200, 3008, 2848, 2688, 2528, 2368, 2240, 2112, 2016, 1888, 1792 }

@e01 = { 1, 0, F, 0=15 }
@e09 = { 1, 0, F, E, B=6 }
@e10 = { 1, 0, F, E, 9=10 }


; 目的: 同一音高の高速な KeyOn/Off 繰り返しで KeyOn エッジ検出と残響処理を確認
; パターン1: 休符を挟まず連続
; パターン2: 小休符入り
; パターン3: 音量を変えながら高速

1 @1 v15 o4 l32 c c c c c c c c
1 @1 v15 o4 l32 c r c r c r c r
1 @1 o4 l32 v14 c v12 c v10 c v8 c v6 c v4 c v2 c

