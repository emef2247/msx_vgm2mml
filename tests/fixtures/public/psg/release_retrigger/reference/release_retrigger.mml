;[name=release_retrigger lpf=1]
#opll_mode 1
#tempo 75
#title { "Release Retrigger" }
#alloc 1=400
#alloc 2=200
#alloc 3=400
#psg_tune { 3392, 3200, 3008, 2848, 2688, 2528, 2368, 2240, 2112, 2016, 1888, 1792 }

@e01 = { 1, 0, F, 0=15 }
@e09 = { 1, 0, F, E, B=6 }
@e10 = { 1, 0, F, E, 9=10 }


; Release 中に再 KeyOn した時の EG / 位相再初期化挙動をチェック。
1 @1 o4 l8 v15 c v10 r v15 c v8 r v15 c v6 r v15 c
1 @1 o5 l4 v14 g r g r