;[name=volume_sweep lpf=1]
#opll_mode 1
#tempo 75
#title { "Volume Sweep" }
#alloc 1=400
#alloc 2=200
#alloc 3=400
#psg_tune { 3392, 3200, 3008, 2848, 2688, 2528, 2368, 2240, 2112, 2016, 1888, 1792 }

@e01 = { 1, 0, F, 0=15 }
@e09 = { 1, 0, F, E, B=6 }
@e10 = { 1, 0, F, E, 9=10 }



; 目的: 音量 (v) 変更タイミングとエンベロープパラメータ適用の差異を検出
; 同一音高 (o4 g) を様々な音量で発音。途中で上昇も行う。

1 @1 o4 l8
1 v15 g v13 g v11 g v9 g v7 g v5 g v3 g v1 g
1 v3 g v5 g v7 g v9 g v11 g v13 g v15 g r