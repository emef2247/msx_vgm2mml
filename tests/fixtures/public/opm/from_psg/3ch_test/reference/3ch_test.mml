;[name=3ch_test lpf=1]
#opll_mode 1
#tempo 75
#title { "3CH Composite Test" }
#alloc 1=400
#alloc 2=200
#alloc 3=400
#psg_tune { 3392, 3200, 3008, 2848, 2688, 2528, 2368, 2240, 2112, 2016, 1888, 1792 }

@e01 = { 1, 0, F, 0=15 }
@e09 = { 1, 0, F, E, B=6 }
@e10 = { 1, 0, F, E, 9=10 }

; 目的:
;  - 異なるパッbbチ/音量/オクターブ
;  - スケール移行
;  - 途中音量変化
;  - タイ (&) による持続
;  - 休符混在
; これら複合で長め安定性チェック (短時間内)

; CH1: メロディ (パッチ1)
1 @0 v14 o4 l8 c d e f g a b > c & c r g e

; CH5: 和声 (パッチ4) - アルペジオ風
2 @9 v12 o3 l16 c g e g c g e g  f a f a  g b g b  c > c < g r r

; CH3: ベース (パッチ7) - オクターブ交互 + 音量変化
3 @10 v13 o2 l8 c v11 c v9 c v13 g v11 g v9 g
3 @10 v13 o2 l8 f r f r g r g r

; 終了休符
1 @0 v14 o4 l4 r
2 @9 v12 o3 l4 r
3 @10 v11 o2 l4 r