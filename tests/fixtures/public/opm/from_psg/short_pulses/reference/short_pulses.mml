;[name=short_pulses lpf=1]
#opll_mode 1
#tempo 75
#title { "Short Pulses" }
#alloc 1=400
#alloc 2=200
#alloc 3=400
#psg_tune { 3392, 3200, 3008, 2848, 2688, 2528, 2368, 2240, 2112, 2016, 1888, 1792 }

@e01 = { 1, 0, F, 0=15 }
@e09 = { 1, 0, F, E, B=6 }
@e10 = { 1, 0, F, E, 9=10 }


; l64 / l128 など最小単位 (環境が許す範囲) を使い高速 KeyOn/Off。
; Retrigger ロジックと Envelope 初期化確認。

1 @1 v15 o5 l64 c c c c c c c c
1 @1 v12 o5 l64 d e f g a b > c
1 @1 v10 o5 l64 c r c r c r c r